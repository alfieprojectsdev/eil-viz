# Rendered at container start by the nginx image's envsubst entrypoint
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/*). Only variables that
# actually exist in the environment are substituted, so nginx's own $uri,
# $host, $remote_addr and friends pass through untouched.
#
# EIL_API_UPSTREAM is the address of the eil-calc process. Under compose that is
# the service name (backend:8000); standalone it might be 127.0.0.1:8000 or a
# host address. The Dockerfile sets the default.

# nginx's default "main" format logs $request, the full request line, so a
# parcel PHAST sent in ?geo= would land in the container log. This logs the
# path without the query string. The referer is dropped too: requests the page
# makes carry its own URL there, ?geo= included. $uri isn't used because
# try_files and index rewrite it to /index.html before the log is written.
map $request_uri $request_path {
    ~^(?<path>[^?]*) $path;
}
log_format eil_noquery '$remote_addr - $remote_user [$time_local] '
                       '"$request_method $request_path $server_protocol" $status $body_bytes_sent '
                       '"$http_user_agent" "$http_x_forwarded_for"';

server {
    listen 80;
    server_name localhost;

    access_log /var/log/nginx/access.log eil_noquery;

    root /usr/share/nginx/html;
    index index.html;

    # Serve static files; any other path gets index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Single origin: the SPA fetches a relative /api/... path, and this is the
    # only hop that knows where the backend lives. Keeps CORS out of the picture
    # and keeps uvicorn off the LAN.
    location /api/ {
        proxy_pass http://${EIL_API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # A nationwide-DEM assessment is CPU-bound and can take a while; the
        # 60 s default would cut it off and show the assessor a 504.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
